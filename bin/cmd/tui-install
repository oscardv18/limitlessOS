#!/usr/bin/env bash
# dot:summary=Genera entradas .desktop para las TUI del ecosistema Limitless
# dot:group=sistema
# dot:glyph=⚙
# dot:requires-sudo=false
# dot:terminal=true
#
# Genera o actualiza entradas .desktop en ~/.local/share/applications
# para que el launcher y QuickShell las reconozcan como aplicaciones
# de escritorio de primera clase (LIMITLESS-OS.md §4.2, plan-automation.md §3).

set -uo pipefail

REPO_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/../.." &>/dev/null && pwd)"
if [[ -f "$REPO_DIR/install/lib/ui.sh" ]]; then
  source "$REPO_DIR/install/lib/ui.sh"
else
  ui_banner() { echo "=== $1 ==="; }
  ui_ok()     { echo "  OK  $1"; }
  ui_fail()   { echo "  ERR $1"; }
  ui_warn()   { echo "  WARN $1"; }
  ui_info()   { echo "  INFO $1"; }
fi

has_cmd() { command -v "$1" >/dev/null 2>&1; }

apps_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
mkdir -p "$apps_dir"

TUIS=(
  "lazygit|Lazygit|⑂"
  "lazydocker|Lazydocker|⌬"
  "btop|Sistema (btop)|◫"
  "nvtop|GPU (nvtop)|◧"
  "yazi|Archivos (yazi)|▣"
  "impala|Wi-Fi (impala)|◈"
  "bluetui|Bluetooth (bluetui)|✦"
  "wiremix|Audio (wiremix)|◨"
  "systemctl-tui|Servicios|⚙"
  "lnav|Registros (lnav)|⌗"
)

create_desktop() {
  local cmd="$1"
  local name="$2"
  local glyph="$3"
  local desktop_file="$apps_dir/limitless-${cmd}.desktop"

  cat >"$desktop_file" <<EOF
[Desktop Entry]
Type=Application
Name=${name}
Comment=Herramienta del ecosistema Limitless (${glyph})
Exec=ghostty -e ${cmd}
Terminal=false
Categories=System;ConsoleOnly;
X-Limitless-Glyph=${glyph}
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "uso: dotctl tui-install [tui...]"
  echo
  echo "Genera o actualiza entradas .desktop en ~/.local/share/applications"
  echo "para las herramientas TUI del ecosistema Limitless."
  echo
  echo "TUIs soportadas:"
  for entry in "${TUIS[@]}"; do
    IFS='|' read -r cmd name glyph <<<"$entry"
    printf '  %-16s %s %s\n' "$cmd" "$glyph" "$name"
  done
  exit 0
fi

n_ok=0
n_skip=0
n_err=0

if [[ $# -eq 0 ]]; then
  # Modo automático: todas las TUIs detectadas en el sistema
  for entry in "${TUIS[@]}"; do
    IFS='|' read -r cmd name glyph <<<"$entry"
    if ! has_cmd "$cmd"; then
      n_skip=$((n_skip + 1))
      continue
    fi
    create_desktop "$cmd" "$name" "$glyph"
    n_ok=$((n_ok + 1))
    ui_ok "$name"
  done

  ui_info "$n_ok entradas generadas, $n_skip omitidas (herramienta no instalada)"
else
  # Modo específico: procesar las TUIs solicitadas
  for target in "$@"; do
    matched=0
    for entry in "${TUIS[@]}"; do
      IFS='|' read -r cmd name glyph <<<"$entry"
      if [[ "$target" == "$cmd" ]]; then
        matched=1
        if ! has_cmd "$cmd"; then
          ui_warn "$cmd no encontrado en PATH (se genera la entrada de todos modos)"
        fi
        create_desktop "$cmd" "$name" "$glyph"
        n_ok=$((n_ok + 1))
        ui_ok "$name"
        break
      fi
    done

    if (( matched == 0 )); then
      ui_fail "TUI desconocida: $target"
      n_err=$((n_err + 1))
    fi
  done
fi

update-desktop-database "$apps_dir" 2>/dev/null || true

if (( n_err > 0 )); then
  exit 1
fi
exit 0
