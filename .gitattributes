# .gitattributes — indispensable trabajando desde Windows hacia un destino
# Linux. Sin esto, cualquier editor de Windows puede colar CRLF o un BOM en
# un script bash y romperlo en silencio en CachyOS: un shebang con CRLF
# (`#!/usr/bin/env bash\r`) no lo reconoce el kernel como intérprete válido,
# y falla con un error que no dice nada sobre la causa real.
#
# Regla: todo texto se normaliza a LF en el repositorio, sin importar cómo
# lo haya guardado el editor localmente. `eol=lf` fuerza LF también en el
# checkout de Windows — no basta con la normalización de entrada.

* text=auto eol=lf

*.sh      text eol=lf
*.bash    text eol=lf
*.lua     text eol=lf
*.toml    text eol=lf
*.conf    text eol=lf
*.zsh     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.qml     text eol=lf
.zshenv   text eol=lf
.zshrc    text eol=lf
dotctl    text eol=lf
doctor    text eol=lf

# binarios de verdad, si el proyecto llega a tenerlos — nunca tocar sus bytes
*.png   binary
*.jpg   binary
*.pf2   binary
*.ttf   binary
*.otf   binary
