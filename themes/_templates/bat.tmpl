<?xml version="1.0" encoding="UTF-8"?>
<!--
  themes/_templates/bat.tmpl — plantilla de matugen para bat.
  Destino real: ~/.config/bat/themes/limitless.tmTheme

  ATENCIÓN, paso extra obligatorio: bat NO lee los .tmTheme sueltos, usa
  una caché binaria. Después de generar este archivo hay que correr
  `bat cache --build` — ya está en install/stages/50-theme.sh. Sin ese
  paso el tema existe en disco y bat lo ignora por completo.

  Formato: .tmTheme (XML de Sublime/TextMate). Verificado contra el README
  de sharkdp/bat: "custom themes must be stored in .tmTheme files. Newer
  .sublime-color-scheme files are currently not supported" — de ahí que
  esto sea XML y no JSON.

  Los scopes de abajo son los estándar de TextMate. El mapeo rol→color
  sigue el criterio ya fijado en stow/nvim/.config/nvim/colors/limitless.lua
  (azul=función, violeta=palabra clave, verde=cadena, ámbar=tipo…), para
  que leer un archivo con `bat` y abrirlo en Neovim no se contradigan.
-->
<plist version="1.0">
<dict>
  <key>name</key>
  <string>limitless</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>
        <string>{{custom.surface_opaque_void.hex}}</string>
        <key>foreground</key>
        <string>{{custom.text_text.hex}}</string>
        <key>caret</key>
        <string>{{custom.technique_lapse_accent.hex}}</string>
        <key>lineHighlight</key>
        <string>{{custom.surface_opaque_hl.hex}}</string>
        <key>selection</key>
        <string>{{custom.surface_opaque_sel.hex}}</string>
        <key>invisibles</key>
        <string>{{custom.text_ghost.hex}}</string>
        <key>gutterForeground</key>
        <string>{{custom.text_mute.hex}}</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>{{custom.text_comment.hex}}</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, string.quoted, punctuation.definition.string</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.syntax_green.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Number / Constant</string>
      <key>scope</key><string>constant.numeric, constant.language, constant.character</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.syntax_orange.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, keyword.control, storage, storage.type.modifier</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.technique_hollow_accent.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Operator</string>
      <key>scope</key><string>keyword.operator, punctuation.separator, punctuation.terminator</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.syntax_cyan.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, support.function, meta.function-call</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.technique_lapse_accent.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Type / Class</string>
      <key>scope</key><string>entity.name.type, entity.name.class, support.type, support.class, storage.type</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.syntax_amber.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Variable / Parameter</string>
      <key>scope</key><string>variable, variable.parameter, variable.other</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.syntax_coral.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Built-in / Field</string>
      <key>scope</key><string>support.variable, variable.language, variable.other.member</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.technique_lapse_accent_core.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Tag</string>
      <key>scope</key><string>entity.name.tag</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.technique_reversal_accent.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Attribute</string>
      <key>scope</key><string>entity.other.attribute-name</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.syntax_amber.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Macro / Preprocessor</string>
      <key>scope</key><string>meta.preprocessor, entity.name.function.preprocessor, keyword.control.import</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.syntax_magenta.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid, invalid.illegal</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.technique_reversal_accent.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Diff inserted</string>
      <key>scope</key><string>markup.inserted</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.syntax_green.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Diff deleted</string>
      <key>scope</key><string>markup.deleted</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.technique_reversal_accent.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Diff changed</string>
      <key>scope</key><string>markup.changed</string>
      <key>settings</key>
      <dict><key>foreground</key><string>{{custom.syntax_amber.hex}}</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Heading</string>
      <key>scope</key><string>markup.heading, entity.name.section</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>{{custom.technique_hollow_accent.hex}}</string>
        <key>fontStyle</key><string>bold</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Link</string>
      <key>scope</key><string>markup.underline.link, string.other.link</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>{{custom.technique_lapse_accent.hex}}</string>
        <key>fontStyle</key><string>underline</string>
      </dict>
    </dict>
  </array>
  <key>uuid</key>
  <string>b7f1a2c4-9d3e-4f8a-b1c6-5e2d7a9f0c31</string>
</dict>
</plist>
